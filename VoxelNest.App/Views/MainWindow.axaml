<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:VoxelNest.App.Views" x:Class="VoxelNest.App.Views.MainWindow"
        Title="{Binding LauncherName}" Width="1260" Height="860" MinWidth="790" MinHeight="610"
        Icon="avares://VoxelNest/Assets/voxelnest.ico" WindowStartupLocation="CenterScreen" FontFamily="fonts:Inter#Inter" FontSize="14">
  <Grid ColumnDefinitions="215,*">
    <Border Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="*,Auto" Margin="17,22,17,18">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Grid ColumnDefinitions="42,*" Margin="4,1,0,35" ColumnSpacing="11">
              <Border Background="{StaticResource Purple}" CornerRadius="11" Width="42" Height="42">
                <PathIcon Data="{StaticResource CubeIcon}" Width="24" Height="24" Foreground="White" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{Binding LauncherName}" TextTrimming="CharacterEllipsis" FontWeight="Bold" FontSize="19" />
                <TextBlock Classes="caption muted" FontSize="10" LetterSpacing="1.5" Text="LAUNCHER" />
              </StackPanel>
            </Grid>
            <StackPanel Spacing="5">
              <TextBlock Classes="eyebrow muted" Margin="12,0,0,7" Text="{Binding L[Workspace]}" />
              <Button Classes="nav" Classes.active="{Binding IsHome}" Command="{Binding NavigateCommand}" CommandParameter="Home">
                <Grid ColumnDefinitions="25,*" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource HomeIcon}" HorizontalAlignment="Left" />
                  <TextBlock Grid.Column="1" Text="{Binding L[Home]}" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsVersions}" Command="{Binding NavigateCommand}" CommandParameter="Versions">
                <Grid ColumnDefinitions="25,*" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource LayersIcon}" HorizontalAlignment="Left" />
                  <TextBlock Grid.Column="1" Text="{Binding L[Versions]}" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsProfiles}" Command="{Binding NavigateCommand}" CommandParameter="Profiles">
                <Grid ColumnDefinitions="25,*" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource UserIcon}" HorizontalAlignment="Left" />
                  <TextBlock Grid.Column="1" Text="{Binding L[Profiles]}" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsDownloads}" Command="{Binding NavigateCommand}" CommandParameter="Downloads">
                <Grid ColumnDefinitions="25,*" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource DownloadIcon}" HorizontalAlignment="Left" />
                  <TextBlock Grid.Column="1" Text="{Binding L[Downloads]}" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <TextBlock Classes="eyebrow muted" Margin="12,24,0,6" Text="{Binding L[Preferences]}" />
              <Button Classes="nav" Classes.active="{Binding IsSettings}" Command="{Binding NavigateCommand}" CommandParameter="Settings">
                <Grid ColumnDefinitions="25,*" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource SettingsIcon}" HorizontalAlignment="Left" />
                  <TextBlock Grid.Column="1" Text="{Binding L[Settings]}" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <Button Classes="nav" Classes.active="{Binding IsAbout}" Command="{Binding NavigateCommand}" CommandParameter="About">
                <Grid ColumnDefinitions="25,*" VerticalAlignment="Center">
                  <PathIcon Data="{StaticResource InfoIcon}" HorizontalAlignment="Left" />
                  <TextBlock Grid.Column="1" Text="{Binding L[About]}" VerticalAlignment="Center" />
                </Grid>
              </Button>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="0,15,0,0">
          <Button Classes="nav" AutomationProperties.Name="{Binding L[Profiles]}" Command="{Binding NavigateCommand}" CommandParameter="Profiles" Padding="7,4">
            <Grid ColumnDefinitions="36,*,12" ColumnSpacing="9">
              <Border Background="{DynamicResource AccentSoft}" CornerRadius="9" ClipToBounds="True" Width="36" Height="36">
                <Panel>
                  <Image Source="avares://VoxelNest/Assets/default-avatar.png" Stretch="UniformToFill" />
                  <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Foreground="{DynamicResource Ink}" Text="{Binding ActiveName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="caption muted" Text="{Binding L[ActiveProfile]}" />
              </StackPanel>
              <PathIcon Grid.Column="2" Width="12" Height="12" Data="{StaticResource ArrowIcon}" />
            </Grid>
          </Button>
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="62,*,Auto">
      <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="29,0">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <TextBlock Classes="muted" FontSize="13" Text="{Binding L[Workspace]}" />
            <TextBlock Classes="muted" FontSize="13" Text="/" />
            <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding PageTitle}" />
          </StackPanel>
          <Border Grid.Column="1" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                  VerticalAlignment="Center" CornerRadius="7" Padding="9,5">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <PathIcon Data="{StaticResource CubeIcon}" Foreground="{DynamicResource AccentText}" Width="13" Height="13" />
              <TextBlock Classes="caption muted" Text="JAVA EDITION" FontWeight="SemiBold" />
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <Panel Grid.Row="1">
        <views:HomeView Classes="screen" Classes.active="{Binding IsHome}" IsVisible="{Binding IsHome}" />
        <views:VersionsView Classes="screen" Classes.active="{Binding IsVersions}" IsVisible="{Binding IsVersions}" />
        <views:ProfilesView Classes="screen" Classes.active="{Binding IsProfiles}" IsVisible="{Binding IsProfiles}" />
        <views:DownloadsView Classes="screen" Classes.active="{Binding IsDownloads}" IsVisible="{Binding IsDownloads}" />
        <views:SettingsView Classes="screen" Classes.active="{Binding IsSettings}" IsVisible="{Binding IsSettings}" />
        <views:AboutView Classes="screen" Classes.active="{Binding IsAbout}" IsVisible="{Binding IsAbout}" />
      </Panel>
      <Border Grid.Row="2" IsVisible="{Binding HasMessage}" Background="{DynamicResource AccentSoft}" Padding="19,8">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" />
          <Button Classes="quiet" Content="×" Command="{Binding ClearMessageCommand}" AutomationProperties.Name="{Binding L[Dismiss]}" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
