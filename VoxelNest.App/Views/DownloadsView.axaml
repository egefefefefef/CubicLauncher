<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VoxelNest.App.Views.DownloadsView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="29,24,29,26" MaxWidth="1120" Spacing="17">
      <StackPanel Spacing="6">
        <TextBlock Classes="eyebrow" Text="{Binding L[Activity]}" />
        <TextBlock Classes="heading" Text="{Binding L[Downloads]}" />
        <TextBlock Classes="muted" Text="{Binding L[DownloadsSubtitle]}" TextWrapping="Wrap" />
      </StackPanel>
      <Border Classes="card">
        <StackPanel Spacing="13">
          <Grid ColumnDefinitions="42,*" ColumnSpacing="11">
            <Border Classes="tile"><PathIcon Data="{StaticResource DownloadIcon}" Foreground="{DynamicResource AccentText}" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
              <TextBlock Classes="section" Text="{Binding L[InstallQueue]}" />
              <TextBlock Classes="caption muted" Text="{Binding DownloadSummary}" />
            </StackPanel>
          </Grid>
          <Grid IsVisible="{Binding IsInstalling}" ColumnDefinitions="*,Auto" ColumnSpacing="9">
            <ProgressBar Value="{Binding DownloadPercent}" Height="6" />
            <TextBlock Grid.Column="1" Classes="caption muted" Text="{Binding DownloadPercent, StringFormat='{}{0:0}%'}" />
          </Grid>
          <TextBlock IsVisible="{Binding IsInstalling}" Classes="caption muted" Text="{Binding DownloadMetrics}" TextWrapping="Wrap" />
          <WrapPanel ItemSpacing="8" LineSpacing="7">
            <Button Content="{Binding L[Cancel]}" Command="{Binding CancelDownloadCommand}" IsVisible="{Binding IsInstalling}" />
            <Button Classes="primary" Content="{Binding L[Retry]}" Command="{Binding RetryDownloadCommand}" IsVisible="{Binding CanRetryDownload}" />
            <Button Classes="quiet" Content="{Binding L[BrowseVersions]}" Command="{Binding NavigateCommand}" CommandParameter="Versions" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
