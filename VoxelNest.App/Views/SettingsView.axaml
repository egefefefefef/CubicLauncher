<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VoxelNest.App.Views.SettingsView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="29,24,29,26" MaxWidth="1120" Spacing="16">
      <StackPanel Spacing="6">
        <TextBlock Classes="eyebrow" Text="{Binding L[Preferences]}" />
        <TextBlock Classes="heading" Text="{Binding L[Settings]}" />
        <TextBlock Classes="muted" Text="{Binding L[SettingsSubtitle]}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Spacing="16" IsEnabled="{Binding CanEdit}">
        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Classes="section" Text="{Binding L[Appearance]}" />
            <TextBlock Classes="caption muted" Text="{Binding L[LauncherName]}" />
            <TextBox Text="{Binding LauncherNameInput}" MaxLength="40" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
              <StackPanel Spacing="5"><TextBlock Classes="caption muted" Text="{Binding L[Theme]}" /><ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding ThemeInput}" /></StackPanel>
              <StackPanel Grid.Column="1" Spacing="5"><TextBlock Classes="caption muted" Text="{Binding L[Language]}" /><ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding LanguageInput}" /></StackPanel>
            </Grid>
            <TextBlock Classes="caption muted" Text="{Binding L[Background]}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding BackgroundInput, Mode=OneWay}" IsReadOnly="True" Watermark="{Binding L[DefaultBackground]}" />
              <WrapPanel Grid.Column="1" ItemSpacing="6">
                <Button Content="{Binding L[Browse]}" Command="{Binding PickBackgroundCommand}" />
                <Button Content="{Binding L[Reset]}" Command="{Binding ResetBackgroundCommand}" />
              </WrapPanel>
            </Grid>
          </StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Classes="section" Text="{Binding L[GameSettings]}" />
            <TextBlock Classes="caption muted" Text="{Binding L[GameFolder]}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding GameRootInput, Mode=OneWay}" IsReadOnly="True" Watermark="{Binding DefaultGamePath}" />
              <WrapPanel Grid.Column="1" ItemSpacing="6">
                <Button Content="{Binding L[Browse]}" Command="{Binding PickGameRootCommand}" />
                <Button Content="{Binding L[Reset]}" Command="{Binding ResetGameRootCommand}" />
              </WrapPanel>
            </Grid>
            <TextBlock Classes="caption muted" Text="{Binding L[GameRootHelp]}" TextWrapping="Wrap" />
            <CheckBox Content="{Binding L[StartAtLogin]}" IsChecked="{Binding StartAtLoginInput}" IsEnabled="{Binding CanSetStartup}" />
            <TextBlock Classes="caption muted" Text="{Binding L[AfterLaunch]}" />
            <ComboBox ItemsSource="{Binding LaunchBehaviors}" SelectedItem="{Binding AfterLaunchInput}" />
            <TextBlock Classes="caption muted" Text="{Binding L[AfterLaunchHelp]}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="9">
            <TextBlock Classes="section" Text="Microsoft OAuth" />
            <TextBlock Classes="caption muted" Text="{Binding L[OAuthHelp]}" TextWrapping="Wrap" />
            <TextBox Text="{Binding MicrosoftClientInput}" Watermark="Application (client) ID" MaxLength="40" />
          </StackPanel>
        </Border>
        <Button Classes="primary" Content="{Binding L[SaveSettings]}" Command="{Binding SaveSettingsCommand}" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
