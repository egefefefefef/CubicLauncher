<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VoxelNest.App.Views.ProfilesView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="29,24,29,26" MaxWidth="1120" Spacing="16">
      <StackPanel Spacing="6">
        <TextBlock Classes="eyebrow" Text="{Binding L[PersonalSpace]}" />
        <TextBlock Classes="heading" Text="{Binding L[Profiles]}" />
        <TextBlock Classes="muted" Text="{Binding L[ProfilesSubtitle]}" TextWrapping="Wrap" />
      </StackPanel>
      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="42,*,Auto" ColumnSpacing="11">
            <Border Classes="tile" Background="{DynamicResource MintSoft}"><PathIcon Data="{StaticResource UserIcon}" Foreground="{DynamicResource MintText}" /></Border>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
              <TextBlock Classes="section" Text="Microsoft · Minecraft" />
              <TextBlock Classes="caption muted" Text="{Binding AccountStatus}" TextWrapping="Wrap" />
            </StackPanel>
            <WrapPanel Grid.Column="2" VerticalAlignment="Center" ItemSpacing="8">
              <Button Classes="primary" Content="{Binding L[SignIn]}" Command="{Binding SignInCommand}" IsEnabled="{Binding CanSignIn}" IsVisible="{Binding !HasSession}" />
              <Button Content="{Binding L[SignOut]}" Command="{Binding SignOutCommand}" IsEnabled="{Binding CanSignIn}" IsVisible="{Binding HasSession}" />
              <Button Content="{Binding L[Cancel]}" Command="{Binding CancelSignInCommand}" IsVisible="{Binding IsSigningIn}" />
            </WrapPanel>
          </Grid>
          <CheckBox Content="{Binding L[RememberSession]}" IsChecked="{Binding RememberSession}" IsEnabled="{Binding CanSignIn}" IsVisible="{Binding !HasSession}" />
          <StackPanel IsVisible="{Binding HasSignInPrompt}" Spacing="8">
            <TextBlock Classes="muted" Text="{Binding L[DeviceHelp]}" TextWrapping="Wrap" />
            <TextBox IsReadOnly="True" Text="{Binding DeviceCode, Mode=OneWay}" HorizontalAlignment="Left" MinWidth="170" />
            <Button Classes="quiet" Content="{Binding DeviceUrl}" Command="{Binding OpenSignInCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
      <Grid ColumnDefinitions="195,*" ColumnSpacing="12" IsEnabled="{Binding CanEdit}">
        <Border Classes="card" Padding="13" VerticalAlignment="Top">
          <StackPanel Spacing="10">
            <TextBlock Classes="eyebrow" Text="{Binding L[LocalProfiles]}" />
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MaxHeight="250" Background="Transparent" AutomationProperties.Name="{Binding L[Profiles]}">
              <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Button Classes="primary" Content="{Binding L[NewProfile]}" Command="{Binding AddProfileCommand}" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card" IsVisible="{Binding HasProfileSelected}">
          <StackPanel Spacing="13">
            <TextBlock Classes="section" Text="{Binding L[ProfileDetails]}" />
            <Border Classes="pill" HorizontalAlignment="Left" IsVisible="{Binding IsSelectedProfileActive}">
              <TextBlock Classes="caption" Text="{Binding L[ActiveProfile]}" Foreground="{DynamicResource MintText}" />
            </Border>
            <TextBlock Classes="muted" Text="{Binding L[DisplayName]}" />
            <TextBox Text="{Binding DisplayNameInput}" MaxLength="40" />
            <TextBlock Classes="caption muted" Text="{Binding L[DisplayNameHelp]}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="{Binding AvatarInput, TargetNullValue='—'}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <WrapPanel Grid.Column="1" ItemSpacing="6">
                <Button Content="{Binding L[ChooseAvatar]}" Command="{Binding PickAvatarCommand}" />
                <Button Content="{Binding L[Reset]}" Command="{Binding ResetAvatarCommand}" />
              </WrapPanel>
            </Grid>
            <TextBlock Classes="eyebrow" Text="{Binding L[ProfileVersion]}" />
            <TextBlock Text="{Binding ProfileVersion}" TextWrapping="Wrap" />
            <Button Classes="quiet" Content="{Binding L[BrowseVersions]}" Command="{Binding NavigateCommand}" CommandParameter="Versions" IsVisible="{Binding IsSelectedProfileActive}" />
            <TextBlock Classes="eyebrow" Text="{Binding L[GameFolder]}" />
            <TextBox Text="{Binding ProfileDirectory, Mode=OneWay}" IsReadOnly="True" />
            <TextBlock Classes="eyebrow" Text="{Binding L[JavaPerformance]}" Margin="0,6,0,0" />
            <TextBlock Classes="caption muted" Text="{Binding L[JavaHelp]}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
              <TextBox Text="{Binding JavaInput}" Watermark="{Binding L[Automatic]}" />
              <Button Grid.Column="1" Content="{Binding L[Browse]}" Command="{Binding PickJavaCommand}" />
            </Grid>
            <Button Content="{Binding L[CheckJava]}" Command="{Binding CheckJavaCommand}" />
            <TextBlock Classes="caption muted" Text="{Binding JavaInfo}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <StackPanel Spacing="5"><TextBlock Classes="caption muted" Text="{Binding L[MinRam]}" /><NumericUpDown Value="{Binding MinRamInput}" Minimum="256" Maximum="65536" Increment="256" /></StackPanel>
              <StackPanel Grid.Column="1" Spacing="5"><TextBlock Classes="caption muted" Text="{Binding L[MaxRam]}" /><NumericUpDown Value="{Binding MaxRamInput}" Minimum="256" Maximum="65536" Increment="256" /></StackPanel>
            </Grid>
            <TextBlock Classes="caption muted" Text="{Binding L[MemoryHelp]}" TextWrapping="Wrap" />
            <TextBlock Classes="caption muted" Text="{Binding L[Resolution]}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
              <NumericUpDown Value="{Binding WidthInput}" Minimum="320" Maximum="8192" AutomationProperties.Name="Width" />
              <NumericUpDown Grid.Column="1" Value="{Binding HeightInput}" Minimum="240" Maximum="8192" AutomationProperties.Name="Height" />
            </Grid>
            <CheckBox Content="{Binding L[Fullscreen]}" IsChecked="{Binding FullscreenInput}" />
            <TextBox Text="{Binding JvmInput}" Watermark="{Binding L[JvmArgs]}" />
            <TextBlock Classes="caption muted" Text="{Binding L[JvmHelp]}" TextWrapping="Wrap" />
            <WrapPanel ItemSpacing="7" LineSpacing="7">
              <Button Classes="primary" Content="{Binding L[Save]}" Command="{Binding SaveProfileCommand}" />
              <Button IsVisible="{Binding CanActivateProfile}" Content="{Binding L[Activate]}" Command="{Binding ActivateProfileCommand}" />
              <Button IsVisible="{Binding CanDeleteProfile}" Content="{Binding L[Remove]}" Command="{Binding AskDeleteProfileCommand}" />
            </WrapPanel>
            <StackPanel IsVisible="{Binding ConfirmProfileDelete}" Spacing="8">
              <TextBlock Classes="muted" Text="{Binding L[ConfirmRemoveProfile]}" TextWrapping="Wrap" />
              <WrapPanel ItemSpacing="8" LineSpacing="6">
                <Button Content="{Binding L[ConfirmRemove]}" Command="{Binding DeleteProfileCommand}" />
                <Button Classes="quiet" Content="{Binding L[Cancel]}" Command="{Binding KeepProfileCommand}" />
              </WrapPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
