<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>CubicLauncher</AssemblyName>
    <Product>CubicLauncher</Product>
    <Description>Minecraft Java Edition launcher</Description>
    <RootNamespace>CubicLauncher.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.1.0</Version>
    <ApplicationIcon>Assets/cubiclauncher.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <ProjectReference Include="../CubicLauncher.Core/CubicLauncher.Core.csproj" />
    <ProjectReference Include="../CubicLauncher.Infrastructure/CubicLauncher.Infrastructure.csproj" />
    <ProjectReference Include="../CubicLauncher.Launcher/CubicLauncher.Launcher.csproj" />
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
</Project>
