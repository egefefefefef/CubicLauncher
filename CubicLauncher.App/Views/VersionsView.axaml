<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CubicLauncher.App.Views.VersionsView">
  <Grid Margin="29,24,29,26" MaxWidth="1320" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="15">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="6">
        <TextBlock Classes="eyebrow" Text="{Binding L[GameLibrary]}" />
        <TextBlock Classes="heading" Text="{Binding L[Versions]}" />
        <TextBlock Classes="muted" Text="{Binding L[VersionsSubtitle]}" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Content="{Binding L[Refresh]}" Command="{Binding RefreshVersionsCommand}" VerticalAlignment="Center" />
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,145" ColumnSpacing="10">
      <TextBox Text="{Binding VersionSearch, UpdateSourceTrigger=PropertyChanged}" Watermark="{Binding L[SearchVersions]}" />
      <ComboBox Grid.Column="1" ItemsSource="{Binding VersionFilters}" SelectedItem="{Binding VersionFilter}" />
    </Grid>
    <StackPanel Grid.Row="2" Spacing="8">
      <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsRefreshing}" Height="3" />
      <TextBlock Classes="muted" IsVisible="{Binding HasCatalogIssue}" Text="{Binding CatalogIssue}" TextWrapping="Wrap" />
    </StackPanel>
    <Grid Grid.Row="3" ColumnDefinitions="*,0.8*" ColumnSpacing="12">
      <Border Classes="card" Padding="8">
        <Panel>
          <ListBox ItemsSource="{Binding VisibleVersions}" SelectedItem="{Binding SelectedVersion}" Background="Transparent"
                 AutomationProperties.Name="{Binding L[Versions]}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="4,6">
                <StackPanel Spacing="4">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Classes="caption muted" Text="{Binding Channel}" />
                </StackPanel>
                <Ellipse Grid.Column="1" Fill="{DynamicResource MintText}" Width="7" Height="7" IsVisible="{Binding Installed}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
          </ListBox>
          <StackPanel IsVisible="{Binding ShowEmptyCatalog}" VerticalAlignment="Center" Margin="15" Spacing="10">
            <Border Classes="tile" HorizontalAlignment="Center"><PathIcon Data="{StaticResource LayersIcon}" Foreground="{DynamicResource AccentText}" /></Border>
            <TextBlock Classes="muted" Text="{Binding L[EmptyCatalog]}" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
        </Panel>
      </Border>
      <Border Grid.Column="1" Classes="card">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="13">
            <Border Classes="tile" HorizontalAlignment="Left"><PathIcon Data="{StaticResource LayersIcon}" Foreground="{DynamicResource AccentText}" /></Border>
            <TextBlock Classes="section" Text="{Binding L[VersionDetails]}" TextWrapping="Wrap" />
            <TextBlock IsVisible="{Binding !HasVersion}" Classes="muted" Text="{Binding L[PickVersionDetails]}" TextWrapping="Wrap" />
            <StackPanel IsVisible="{Binding HasVersion}" Spacing="12">
              <TextBlock FontSize="23" FontWeight="Bold" Text="{Binding SelectedVersion.Id}" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="7">
                <TextBlock Classes="muted" Text="{Binding SelectedVersion.Channel}" />
                <TextBlock Classes="muted" Text="·" />
                <TextBlock Classes="muted" Text="{Binding SelectedVersion.Date}" />
              </StackPanel>
              <Border Classes="pill" IsVisible="{Binding SelectedVersion.Installed}" HorizontalAlignment="Left">
                <TextBlock Classes="caption" Text="{Binding L[Installed]}" Foreground="{DynamicResource MintText}" />
              </Border>
              <TextBlock Classes="eyebrow" Text="{Binding SelectedVersion.Platform}" />
              <WrapPanel Orientation="Horizontal" ItemSpacing="7" LineSpacing="7">
                <Button Classes="primary" Content="{Binding L[Install]}" Command="{Binding InstallSelectedVersionCommand}" IsEnabled="{Binding CanInstallVersion}" IsVisible="{Binding !SelectedVersion.Installed}" />
                <Button Content="{Binding L[UseVersion]}" Command="{Binding ChooseSelectedVersionCommand}" IsEnabled="{Binding CanChooseVersion}" />
                <Button Content="{Binding L[Repair]}" Command="{Binding RepairVersionCommand}" IsVisible="{Binding CanRepairVersion}" />
                <Button Content="{Binding L[Remove]}" Command="{Binding AskDeleteVersionCommand}" IsVisible="{Binding CanRemoveVersion}" />
              </WrapPanel>
              <StackPanel IsVisible="{Binding CanBrowseLoaders}" Spacing="9" Margin="0,6,0,0">
                <TextBlock Classes="eyebrow" Text="{Binding L[ModLoaders]}" />
                <WrapPanel ItemSpacing="7" LineSpacing="6">
                  <Button Content="Fabric" Command="{Binding FindLoadersCommand}" CommandParameter="Fabric" />
                  <Button Content="Quilt" Command="{Binding FindLoadersCommand}" CommandParameter="Quilt" />
                  <Button Content="Forge" Command="{Binding FindLoadersCommand}" CommandParameter="Forge" />
                  <Button Content="NeoForge" Command="{Binding FindLoadersCommand}" CommandParameter="NeoForge" />
                </WrapPanel>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingLoaders}" Height="3" />
                <TextBlock Classes="caption muted" Text="{Binding LoaderHint}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsVisible="{Binding HasLoaderOptions}">
                  <ComboBox ItemsSource="{Binding LoaderOptions}" SelectedItem="{Binding SelectedLoader}">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Version}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="1" Classes="primary" Content="{Binding L[Install]}" Command="{Binding InstallLoaderCommand}" IsEnabled="{Binding CanInstallLoader}" />
                </Grid>
              </StackPanel>
              <StackPanel IsVisible="{Binding ConfirmVersionDelete}" Spacing="8">
                <TextBlock Classes="muted" Text="{Binding L[ConfirmRemoveVersion]}" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal" ItemSpacing="7" LineSpacing="7">
                  <Button Content="{Binding L[ConfirmRemove]}" Command="{Binding DeleteVersionCommand}" />
                  <Button Classes="quiet" Content="{Binding L[Cancel]}" Command="{Binding KeepVersionCommand}" />
                </WrapPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
