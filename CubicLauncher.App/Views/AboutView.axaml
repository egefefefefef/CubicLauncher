<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CubicLauncher.App.Views.AboutView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="29,24,29,26" MaxWidth="1120" Spacing="17">
      <StackPanel Spacing="6">
        <TextBlock Classes="eyebrow" Text="CUBICLAUNCHER  /  JAVA EDITION" />
        <TextBlock Classes="heading" Text="{Binding L[About]}" />
        <TextBlock Classes="muted" Text="{Binding L[AboutSubtitle]}" TextWrapping="Wrap" />
      </StackPanel>
      <Border Classes="card">
        <StackPanel Spacing="15">
          <Grid ColumnDefinitions="57,*" ColumnSpacing="13">
            <Border Background="{StaticResource Purple}" CornerRadius="14" Width="57" Height="57">
              <PathIcon Data="{StaticResource CubeIcon}" Width="31" Height="31" Foreground="White" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
              <TextBlock FontSize="24" FontWeight="Bold" Text="{Binding LauncherName}" />
              <TextBlock Classes="eyebrow" Text="{Binding AppVersion}" />
            </StackPanel>
          </Grid>
          <TextBlock Classes="muted" Text="{Binding L[Disclaimer]}" TextWrapping="Wrap" />
          <WrapPanel ItemSpacing="12" LineSpacing="8">
            <Button Content="{Binding L[ProjectRepository]}" Command="{Binding OpenProjectCommand}" />
            <Button Content="{Binding L[OpenGameLog]}" Command="{Binding OpenGameLogCommand}" IsVisible="{Binding HasGameLog}" />
          </WrapPanel>
        </StackPanel>
      </Border>
      <Border Classes="card">
        <StackPanel Spacing="9">
          <TextBlock Classes="section" Text="{Binding L[Diagnostics]}" />
          <TextBlock Classes="caption muted" Text="{Binding L[LogLocation]}" />
          <TextBox Text="{Binding LogPath, Mode=OneWay}" IsReadOnly="True" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
