<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CubicLauncher.App.Views.HomeView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="29,24,29,27" MaxWidth="1320" Spacing="18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" Margin="0,0,0,2">
        <StackPanel Spacing="6">
          <TextBlock Classes="eyebrow" Text="{Binding L[Overview]}" />
          <TextBlock Classes="heading" Text="{Binding Greeting}" TextWrapping="Wrap" />
          <TextBlock Classes="muted" Text="{Binding L[HomeSubtitle]}" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1" VerticalAlignment="Center" Padding="9,7" Command="{Binding NavigateCommand}" CommandParameter="Profiles"
                Background="{DynamicResource Card}" BorderBrush="{DynamicResource Stroke}" AutomationProperties.Name="{Binding L[Profiles]}">
          <Grid ColumnDefinitions="34,*" ColumnSpacing="9">
            <Border Width="34" Height="34" CornerRadius="8" ClipToBounds="True">
              <Panel>
                <Image Source="avares://CubicLauncher/Assets/default-avatar.png" Stretch="UniformToFill" />
                <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
              </Panel>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" MaxWidth="110">
              <TextBlock FontSize="11" Classes="muted" Text="{Binding L[ActiveProfile]}" />
              <TextBlock FontWeight="SemiBold" Text="{Binding ActiveName}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Button>
      </Grid>
      <Border Height="333" ClipToBounds="True" CornerRadius="17" Background="#171529" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
        <Panel>
          <Image Source="avares://CubicLauncher/Assets/nest-landscape.jpg" Stretch="UniformToFill" />
          <Image Source="{Binding BackgroundImage}" Stretch="UniformToFill" />
          <Border Background="{StaticResource HeroShade}" />
          <Grid RowDefinitions="*,Auto" Margin="26,27">
            <StackPanel Spacing="11" VerticalAlignment="Center" HorizontalAlignment="Left" Width="365">
              <Border HorizontalAlignment="Left" CornerRadius="6" Padding="8,5" Background="#3F393664" BorderBrush="#6B706197" BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource SparkIcon}" Width="11" Height="11" Foreground="#DBC9FF" />
                  <TextBlock Text="{Binding L[YourNextAdventure]}" Foreground="#E1D3FF" FontSize="10" LetterSpacing="0.9" FontWeight="Bold" />
                </StackPanel>
              </Border>
              <TextBlock FontSize="46" LetterSpacing="-1.9" FontWeight="ExtraBold" Foreground="{StaticResource HeroInk}" Text="Minecraft" />
              <TextBlock Text="{Binding L[HeroSubtitle]}" Foreground="{StaticResource HeroMuted}" Width="315" HorizontalAlignment="Left" TextWrapping="Wrap" LineHeight="21" />
              <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,7,0,0">
                <Button Classes="primary" Height="46" MinWidth="142" Padding="15,10" IsEnabled="{Binding CanPrimary}" Command="{Binding PrimaryActionCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <PathIcon Data="{StaticResource PlayIcon}" Width="13" Height="13" />
                    <TextBlock Text="{Binding PrimaryLabel}" />
                  </StackPanel>
                </Button>
                <Button Classes="quiet" Foreground="White" Content="{Binding L[Cancel]}" Command="{Binding CancelLaunchCommand}" IsVisible="{Binding IsLaunching}" />
                <Border VerticalAlignment="Center" CornerRadius="7" Padding="10,8" Background="#98202035" BorderBrush="#5E7A7397" BorderThickness="1">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource LayersIcon}" Foreground="#DCCFFF" Width="13" Height="13" />
                    <TextBlock Text="{Binding SelectedVersionLabel}" FontSize="12" Foreground="{StaticResource HeroInk}" MaxWidth="164" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,15,0,0">
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Panel Width="6" Height="6">
                  <Ellipse Fill="#AB9CD2" />
                  <Ellipse Fill="#9EDCBD" IsVisible="{Binding IsSelectedInstalled}" />
                </Panel>
                <TextBlock Text="{Binding InstallationStatus}" Foreground="{StaticResource HeroMuted}" FontSize="12" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding L[WorldLabel]}" Foreground="{StaticResource HeroMuted}" FontWeight="SemiBold" FontSize="10" LetterSpacing="1.7" />
            </Grid>
          </Grid>
        </Panel>
      </Border>
      <Grid ColumnDefinitions="*,Auto" Margin="0,3,0,0">
        <StackPanel Spacing="4">
          <TextBlock Classes="section" Text="{Binding L[QuickAccess]}" />
          <TextBlock Classes="caption muted" Text="{Binding L[QuickSubtitle]}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Classes="eyebrow" Text="01 — 03" VerticalAlignment="Center" />
      </Grid>
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
        <Border Classes="card" Padding="15">
          <StackPanel Spacing="9">
            <Border Classes="tile" HorizontalAlignment="Left"><PathIcon Data="{StaticResource LayersIcon}" Foreground="{DynamicResource AccentText}" /></Border>
            <TextBlock FontWeight="SemiBold" Text="{Binding L[Versions]}" />
            <TextBlock Classes="caption muted" Text="{Binding L[VersionsCard]}" TextWrapping="Wrap" MinHeight="33" />
            <Button Classes="quiet" Command="{Binding NavigateCommand}" CommandParameter="Versions">
              <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="{Binding L[BrowseVersions]}" /><PathIcon Width="13" Height="13" Data="{StaticResource ArrowIcon}" /></StackPanel>
            </Button>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Classes="card" Padding="15">
          <StackPanel Spacing="9">
            <Border Classes="tile" Background="{DynamicResource MintSoft}" HorizontalAlignment="Left"><PathIcon Data="{StaticResource UserIcon}" Foreground="{DynamicResource MintText}" /></Border>
            <TextBlock FontWeight="SemiBold" Text="{Binding L[Profiles]}" />
            <TextBlock Classes="caption muted" Text="{Binding L[ProfilesCard]}" TextWrapping="Wrap" MinHeight="33" />
            <Button Classes="quiet" Command="{Binding NavigateCommand}" CommandParameter="Profiles">
              <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="{Binding L[ManageProfiles]}" /><PathIcon Width="13" Height="13" Data="{StaticResource ArrowIcon}" /></StackPanel>
            </Button>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Classes="card" Padding="15">
          <StackPanel Spacing="9">
            <Border Classes="tile" HorizontalAlignment="Left"><PathIcon Data="{StaticResource DownloadIcon}" Foreground="{DynamicResource AccentText}" /></Border>
            <TextBlock FontWeight="SemiBold" Text="{Binding L[Downloads]}" />
            <TextBlock Classes="caption muted" Text="{Binding L[DownloadsCard]}" TextWrapping="Wrap" MinHeight="33" />
            <Button Classes="quiet" Command="{Binding NavigateCommand}" CommandParameter="Downloads">
              <StackPanel Orientation="Horizontal" Spacing="7"><TextBlock Text="{Binding L[ViewQueue]}" /><PathIcon Width="13" Height="13" Data="{StaticResource ArrowIcon}" /></StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Grid>
      <Border Classes="card" Padding="15,9">
        <Grid ColumnDefinitions="30,*,Auto" ColumnSpacing="9">
          <PathIcon Data="{StaticResource DownloadIcon}" Foreground="{DynamicResource AccentText}" />
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
            <TextBlock Classes="caption muted" Text="{Binding DownloadSummary}" TextTrimming="CharacterEllipsis" />
            <ProgressBar IsVisible="{Binding IsInstalling}" Value="{Binding DownloadPercent}" Height="3" />
          </StackPanel>
          <Button Grid.Column="2" Classes="quiet" Content="{Binding L[ViewQueue]}" Command="{Binding NavigateCommand}" CommandParameter="Downloads" />
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
