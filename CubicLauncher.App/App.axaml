<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CubicLauncher.App.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Canvas">#101119</SolidColorBrush>
          <SolidColorBrush x:Key="Sidebar">#14151F</SolidColorBrush>
          <SolidColorBrush x:Key="Card">#191B27</SolidColorBrush>
          <SolidColorBrush x:Key="Raised">#222434</SolidColorBrush>
          <SolidColorBrush x:Key="Stroke">#2B2D3D</SolidColorBrush>
          <SolidColorBrush x:Key="Ink">#F2F0FA</SolidColorBrush>
          <SolidColorBrush x:Key="Muted">#A2A2BB</SolidColorBrush>
          <SolidColorBrush x:Key="AccentText">#C0ADFF</SolidColorBrush>
          <SolidColorBrush x:Key="AccentSoft">#292243</SolidColorBrush>
          <SolidColorBrush x:Key="MintText">#83E4C0</SolidColorBrush>
          <SolidColorBrush x:Key="MintSoft">#18312E</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Canvas">#F4F3FA</SolidColorBrush>
          <SolidColorBrush x:Key="Sidebar">#FDFBFF</SolidColorBrush>
          <SolidColorBrush x:Key="Card">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="Raised">#ECEAF5</SolidColorBrush>
          <SolidColorBrush x:Key="Stroke">#DDD9EA</SolidColorBrush>
          <SolidColorBrush x:Key="Ink">#201934</SolidColorBrush>
          <SolidColorBrush x:Key="Muted">#615B76</SolidColorBrush>
          <SolidColorBrush x:Key="AccentText">#5A36A7</SolidColorBrush>
          <SolidColorBrush x:Key="AccentSoft">#EBE2FF</SolidColorBrush>
          <SolidColorBrush x:Key="MintText">#155A44</SolidColorBrush>
          <SolidColorBrush x:Key="MintSoft">#DBF3EB</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="Purple">#7955E7</SolidColorBrush>
      <SolidColorBrush x:Key="PurpleHover">#8865F3</SolidColorBrush>
      <SolidColorBrush x:Key="HeroInk">#FFFCFF</SolidColorBrush>
      <SolidColorBrush x:Key="HeroMuted">#D2CCEA</SolidColorBrush>
      <LinearGradientBrush x:Key="HeroShade" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#F0101021" Offset="0" />
        <GradientStop Color="#CE101020" Offset="0.32" />
        <GradientStop Color="#47101020" Offset="0.69" />
        <GradientStop Color="#15101020" Offset="1" />
      </LinearGradientBrush>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
